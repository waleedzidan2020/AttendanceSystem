@{
    ViewData["Title"] = "تسجيل دخول المسؤول";
    Layout = "_Layout";
}
<div class="login-page min-vh-100 d-flex align-items-center justify-content-center p-3">
    <form class="login-card" id="loginForm">
        <h1 class="h3 text-center mb-4">تسجيل دخول المسؤول</h1>
        <div class="mb-3">
            <label class="form-label">البريد الإلكتروني</label>
            <input type="email" class="form-control form-control-lg" id="email" required />
        </div>
        <div class="mb-3">
            <label class="form-label">كلمة المرور</label>
            <div class="input-group">
                <input type="password" class="form-control form-control-lg" id="password" required />
                <button class="btn btn-outline-secondary" type="button" id="togglePassword">إظهار</button>
            </div>
        </div>
        <button class="btn btn-primary w-100 btn-lg" id="loginBtn">تسجيل الدخول</button>
        <div id="loginError" class="mt-3"></div>
    </form>
</div>
@section Scripts {
<script>
const form=document.getElementById('loginForm');
const pwd=document.getElementById('password');
document.getElementById('togglePassword').addEventListener('click',()=>{pwd.type=pwd.type==='password'?'text':'password';});
form.addEventListener('submit',async e=>{
 e.preventDefault(); const btn=document.getElementById('loginBtn'); const box=document.getElementById('loginError');
 btn.disabled=true; btn.textContent='جاري تسجيل الدخول...'; box.innerHTML='';
 try{
   await apiRequest(ApiEndpoints.admin.auth.login,{method:'POST',body:JSON.stringify({email:document.getElementById('email').value.trim(),password:pwd.value})});
   window.location='/admin/dashboard';
 }catch(err){box.innerHTML='<div class="alert alert-danger">بيانات الدخول غير صحيحة أو تعذر تسجيل الدخول.</div>';}
 finally{btn.disabled=false; btn.textContent='تسجيل الدخول';}
});
</script>
}
