@{ ViewData["Title"]="العمال"; Layout="_AdminLayout"; }
<div class="d-flex flex-wrap gap-2 justify-content-between mb-3">
  <input id="employeeSearch" class="form-control" style="max-width:360px" placeholder="بحث بالاسم أو الكود" />
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#employeeModal" id="addEmployeeBtn">إضافة عامل</button>
</div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>الكود</th><th>الاسم</th><th>الهاتف</th><th>الموقع</th><th>الحالة</th><th></th></tr></thead><tbody id="employeesBody"></tbody></table></div></div>
<div class="modal fade" id="employeeModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">بيانات العامل</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">
<input type="hidden" id="employeeId" /><div class="mb-2"><label class="form-label">كود العامل</label><input id="employeeCodeForm" class="form-control" /></div><div class="mb-2"><label class="form-label">الاسم</label><input id="employeeNameForm" class="form-control" /></div><div class="mb-2"><label class="form-label">الهاتف</label><input id="employeePhoneForm" class="form-control" /></div><div class="mb-2"><label class="form-label">موقع العمل</label><select id="employeeSiteForm" class="form-select"></select></div><div class="form-check mt-3"><input id="employeeActiveForm" class="form-check-input" type="checkbox" checked><label class="form-check-label">نشط</label></div>
</div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button><button class="btn btn-primary" id="saveEmployeeBtn">حفظ</button></div></div></div></div>
@section Scripts { <script src="~/js/employees.js" asp-append-version="true"></script> }
