@{ ViewData["Title"]="الحضور"; Layout="_AdminLayout"; }
<div class="row g-2 mb-3"><div class="col-md-3"><input id="filterDate" type="date" class="form-control" /></div><div class="col-md-3"><select id="filterSite" class="form-select"><option value="">كل المواقع</option></select></div><div class="col-md-3"><input id="filterEmployee" class="form-control" placeholder="كود العامل" /></div><div class="col-md-3"><select id="filterStatus" class="form-select"><option value="">كل الحالات</option><option>Present</option><option>Late</option><option>Completed</option></select></div></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>العامل</th><th>الكود</th><th>الموقع</th><th>الدخول</th><th>الخروج</th><th>المسافة</th><th>الدقة</th><th>الحالة</th></tr></thead><tbody id="attendanceListBody"></tbody></table></div></div>
@section Scripts { <script src="~/js/attendance.js" asp-append-version="true"></script> }
