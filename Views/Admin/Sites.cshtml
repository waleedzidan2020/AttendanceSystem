@{ ViewData["Title"]="مواقع العمل"; Layout="_AdminLayout"; }
<div class="d-flex justify-content-end mb-3"><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#siteModal" id="addSiteBtn">إضافة موقع</button></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>الموقع</th><th>Latitude</th><th>Longitude</th><th>النطاق</th><th>أقصى دقة</th><th>الحالة</th><th></th></tr></thead><tbody id="sitesBody"></tbody></table></div></div>
<div class="modal fade" id="siteModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">بيانات الموقع</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">
<input type="hidden" id="siteId"/><div class="mb-2"><label class="form-label">اسم الموقع</label><input id="siteName" class="form-control"/></div><div class="mb-2"><label class="form-label">الوصف</label><textarea id="siteDescription" class="form-control"></textarea></div><div class="row g-2"><div class="col-6"><label class="form-label">Latitude</label><input id="siteLat" class="form-control" type="number" step="0.0000001"/></div><div class="col-6"><label class="form-label">Longitude</label><input id="siteLng" class="form-control" type="number" step="0.0000001"/></div></div><div class="row g-2 mt-1"><div class="col-6"><label class="form-label">Allowed Radius</label><input id="siteRadius" class="form-control" type="number" value="100"/></div><div class="col-6"><label class="form-label">Max Accuracy</label><input id="siteAccuracy" class="form-control" type="number" value="50"/></div></div><div class="form-check mt-3"><input id="siteActive" class="form-check-input" type="checkbox" checked><label class="form-check-label">نشط</label></div>
</div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button><button class="btn btn-primary" id="saveSiteBtn">حفظ</button></div></div></div></div>
@section Scripts { <script src="~/js/sites.js" asp-append-version="true"></script> }
