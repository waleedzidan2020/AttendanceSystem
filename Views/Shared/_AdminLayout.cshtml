<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - لوحة الإدارة</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="d-none">@Html.AntiForgeryToken()</div>
<div class="admin-shell">
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">نظام الحضور</div>
        <nav class="nav flex-column gap-1">
            <a class="nav-link" href="/admin/dashboard">لوحة التحكم</a>
            <a class="nav-link" href="/admin/employees">العمال</a>
            <a class="nav-link" href="/admin/sites">مواقع العمل</a>
            <a class="nav-link" href="/admin/attendance">الحضور</a>
            <a class="nav-link" href="/admin/rejected-attempts">المحاولات المرفوضة</a>
            <a class="nav-link" href="/admin/reports">التقارير</a>
            <button class="btn btn-outline-light mt-3" id="logoutBtn">تسجيل الخروج</button>
        </nav>
    </aside>
    <section class="admin-content">
        <header class="admin-topbar">
            <button class="btn btn-outline-secondary d-lg-none" id="menuBtn">☰</button>
            <h1 class="h5 m-0">@ViewData["Title"]</h1>
        </header>
        <main class="p-3 p-lg-4">@RenderBody()</main>
    </section>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/api-endpoints.js" asp-append-version="true"></script>
<script src="~/js/api.js" asp-append-version="true"></script>
<script>
    document.getElementById('menuBtn')?.addEventListener('click',()=>document.getElementById('sidebar')?.classList.toggle('open'));
    document.getElementById('logoutBtn')?.addEventListener('click', async ()=>{
      try { await apiRequest(ApiEndpoints.admin.auth.logout,{method:'POST'}); } catch(_) {}
      window.location='/admin/login';
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
